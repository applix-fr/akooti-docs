# Copiez ce fichier en `.env.local` — Next.js ne lit que `.env.local` en développement.

# ─── Site ────────────────────────────────────────────────────────────────────
# URL canonique : sert de `metadataBase` (Open Graph, Twitter cards) et de base
# aux liens absolus. En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Assistant « Ask AI » (/api/chat) ────────────────────────────────────────
# N'importe quel endpoint compatible OpenAI : LLM Gateway, Ollama, LM Studio,
# vLLM, llama.cpp, LiteLLM… L'URL doit inclure le suffixe /v1.
#   LLM Gateway   https://api.llmgateway.io/v1   (défaut si la variable est absente)
#   Ollama        http://localhost:11434/v1
#   LM Studio     http://localhost:1234/v1
#   vLLM          http://localhost:8000/v1
LLM_GATEWAY_API_BASE=http://localhost:10100/v1

# Clé envoyée en `Authorization: Bearer`. Les serveurs locaux l'ignorent :
# laisser `dummy` suffit.
LLM_GATEWAY_API_KEY=dummy

# Modèle, au format du serveur interrogé (`<provider>/<modèle>` pour une
# passerelle, simple identifiant pour un serveur local).
# Défaut si absent : anthropic/claude-3.5-sonnet
LLM_GATEWAY_MODEL=opencode-go/deepseek-v4.1-flash

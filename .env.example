# Copiez ce fichier en `.env.local` — Next.js ne lit que `.env.local` en développement.

# ─── Site ────────────────────────────────────────────────────────────────────
# URL canonique du site : sert de `metadataBase` (Open Graph, Twitter cards) et
# de base aux liens absolus. En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Assistant « Ask AI » (/api/chat) ────────────────────────────────────────
# Clé de la passerelle LLM (llmgateway.io). Optionnelle : sans elle, tout le
# site fonctionne, seul le chat répond une erreur.
LLM_GATEWAY_API_KEY=

# Modèle utilisé par l'assistant, au format provider/modèle. Défaut si absent :
# anthropic/claude-3.5-sonnet
LLM_GATEWAY_MODEL=anthropic/claude-3.5-sonnet
